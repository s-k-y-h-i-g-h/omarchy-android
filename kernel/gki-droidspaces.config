# Droidspaces GKI config block — merge into arch/arm64/configs/gki_defconfig
# (GKI kernels 5.4/5.10/5.15/6.1/6.6). Apply the kABI patches FIRST.
# Do NOT use this as a fragment on GKI — edit gki_defconfig directly.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW access
CONFIG_DEVTMPFS=y

# Networking (enhanced NAT)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- optional, recommended ---
CONFIG_USER_NS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# UFW
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs xattr / posix acl (NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
